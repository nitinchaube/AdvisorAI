# ============================================================
# AdvisorAI - Git Ignore
# ============================================================

# ----- Environment / Secrets -----
.env
.env.local
.env.*.local
.env.production
*.pem
*.key
**/serviceAccountKey*.json
**/firebase_key*.json
.env.production
.env.staging
.env.development
# ----- Python -----
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg

# ----- Node -----
node_modules/
frontend/dist/
frontend/dist-ssr/

# ----- Editor -----
.vscode/
.idea/
*.swp
*.swo
.DS_Store

data/
data.zip
VectorDB_v2/
VectorDB/

# ----- Uploads (user data) -----
backend/uploads/

# ----- Fine-tuning data/output (large, do not commit) -----
DataPreparation/output/
DataPreparation/Fine_tuning/Tokenized_dataset/
DataPreparation/Fine_tuning/checkpoints/
DataPreparation/Fine_tuning/runs/

# ----- Demo media (large, host externally) -----
*.mp4
*.mov
*.avi
*.mkv
*.webm

# ----- Generated training datasets -----
*.jsonl
*.arrow
!**/sample*.jsonl
!**/example*.jsonl

# ----- Logs -----
*.log

# ----- Security / Secrets (additional) -----
.env.*
!.env.example
*.p12
*.pfx
*.crt
*.cer
*.jks
*.keystore
**/*private_key*.json

# ----- Large ML / Data Artifacts -----
**/checkpoints/
**/checkpoint-*/
**/models/
**/artifacts/
**/wandb/
**/mlruns/
