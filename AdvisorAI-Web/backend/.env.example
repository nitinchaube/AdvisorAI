# ============================================================
# AdvisorAI Backend - Environment Configuration
# Copy this file to .env and fill in your values.
#
# To switch between dev and prod, change FLASK_ENV and the
# related values below.  Everything else stays the same.
# ============================================================

# ┌─────────────────────────────────────────────────────────────
# │  ENVIRONMENT SWITCH
# │  Set to "development" for local dev, "production" for GCP
# └─────────────────────────────────────────────────────────────
FLASK_ENV=development

# ----- Flask App -----
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
PORT=5003
APP_HOST=0.0.0.0
LOG_LEVEL=INFO

# ----- CORS -----
# Dev: localhost origins.  Prod: your Firebase Hosting domain.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ----- Frontend URL (used for email verification links) -----
# Dev: http://localhost:5173   Prod: https://advisoraii.web.app
FRONTEND_URL=http://localhost:5173

# ----- MongoDB -----
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_NAME=AdvisorAI

# ----- Firebase -----
# Uses Application Default Credentials (ADC).
# Local dev:  gcloud auth application-default login
# GCP runtime: automatic via default service account.
GOOGLE_CLOUD_PROJECT=advisoraii

# ----- LLM -----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-sonnet-20240229

# ----- Vector Database -----
VECTORDB_DIR=./VectorDB
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Retrieval -----
TOP_K_PER_COLLECTION=5
MAX_TOTAL_DOCS=5

# ----- Web Search -----
WEB_SEARCH_ENABLED=true
WEB_SEARCH_RESULTS=3
SERPAPI_API_KEY=

# ----- Memory -----
MEMORY_TYPE=in_memory

# ----- Concurrency -----
MAX_CONCURRENT_TOOLS=3

# ----- Data Files -----
JOBS_CSV_PATH=jobs.csv
INTERNSHIPS_CSV_PATH=internships.csv
UPLOAD_DIR=uploads
