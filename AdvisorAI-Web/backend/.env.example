# ============================================================
# AdvisorAI Backend - Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# ----- Flask App Configuration -----
FLASK_ENV=development
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_SECRET
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_JWT_SECRET
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24
DEBUG=true
APP_HOST=0.0.0.0
PORT=5003
LOG_LEVEL=INFO

# ----- CORS Configuration -----
# Comma-separated list of allowed origins (no trailing slashes)
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://127.0.0.1:3002,http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://localhost:5003,http://127.0.0.1:5003

# ----- Frontend URL (used for email verification links etc.) -----
FRONTEND_URL=http://localhost:3000

# ----- MongoDB Configuration -----
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=AdvisorAI

# ----- Firebase Configuration -----
# Option 1 (recommended for production): Paste the ENTIRE service account JSON as a single line
# FIREBASE_CREDENTIALS_JSON='{"type":"service_account","project_id":"your-project",...}'
#
# Option 2 (local dev): Path to the service account JSON file
# FIREBASE_CREDENTIALS_PATH=firebae_key1.json
#
# Priority: FIREBASE_CREDENTIALS_JSON is checked first; if empty, falls back to file path


# ----- LLM Configuration -----
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-sonnet-20240229

# ----- Vector Database Configuration -----
VECTORDB_DIR=./VectorDB
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ----- Retrieval Configuration -----
TOP_K_PER_COLLECTION=5
MAX_TOTAL_DOCS=5

# ----- Web Search Configuration -----
WEB_SEARCH_ENABLED=true
WEB_SEARCH_RESULTS=3
SERPAPI_API_KEY=

# ----- Memory Configuration -----
MEMORY_TYPE=in_memory
POSTGRES_URL=

# ----- Concurrency Configuration -----
MAX_CONCURRENT_TOOLS=3

# ----- API Configuration (chatbot sub-service) -----
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:5003

# ----- Data Files -----
JOBS_CSV_PATH=jobs.csv
INTERNSHIPS_CSV_PATH=internships.csv

# ----- Upload Configuration -----
UPLOAD_DIR=uploads
